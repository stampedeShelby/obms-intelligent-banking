# ---------------------------------------------------------------------------
# OBMS environment template. Copy to .env and adjust.
#
# Nothing here is a real credential. The values are local development
# defaults; every one is overridden in any real deployment.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=obms
DB_USERNAME=obms_user
DB_PASSWORD=obms_password

# --- Security --------------------------------------------------------------
# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
OBMS_JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes
OBMS_JWT_MINUTES=30

# --- Demo and debugging ----------------------------------------------------
# Seeds demo customers and six months of transaction history.
OBMS_DEMO=false
# Writes one-time codes to the application log. LOCAL DEMO ONLY - never
# enable this anywhere a real person could read the logs.
OBMS_OTP_DEBUG=false

# --- Services --------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
SERVER_PORT=8080
OBMS_FRAUD_ENABLED=true

# --- Email -----------------------------------------------------------------
# With no SMTP server reachable, notifications are written in-app only and
# marked undispatched. The system never claims to have sent an email it did not.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Frontend --------------------------------------------------------------
# Empty in development: Vite proxies /api to the backend.
VITE_API_BASE_URL=
