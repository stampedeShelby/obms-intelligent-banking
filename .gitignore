# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
dependency-reduced-pom.xml

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python / AI service ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Trained model artefacts are rebuilt by the training script, not committed.
ai-service/models/*.joblib
ai-service/models/*.pkl

# ---- Secrets and local config ----
# Never commit real credentials. .env.example is the committed template.
.env
.env.*
!.env.example
*.pem
*.key
!src/**/*.key

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp
.project
.classpath
.settings/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Build / analysis reports ----
# Static analysis OUTPUT is regenerated by CI and lives under target/, which is
# already ignored above. These patterns are scoped to target/ deliberately:
# a bare backend/spotbugs*.xml would also exclude spotbugs-exclude.xml, which
# is configuration the build needs and must be committed.
backend/target/spotbugs*.html
backend/target/spotbugs*.xml
backend/target/pmd.xml
backend/target/cpd.xml
logs/
*.log
