# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
dependency-reduced-pom.xml

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python / AI service ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Trained model artefacts are rebuilt by the training script, not committed.
ai-service/models/*.joblib
ai-service/models/*.pkl

# ---- Secrets and local config ----
# Never commit real credentials. .env.example is the committed template.
.env
.env.*
!.env.example
*.pem
*.key
!src/**/*.key

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp
.project
.classpath
.settings/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Build / analysis reports ----
# Static analysis output is regenerated by CI; the summary lives in docs/.
backend/spotbugs*.html
backend/spotbugs*.xml
backend/pmd.xml
backend/cpd.xml
logs/
*.log
